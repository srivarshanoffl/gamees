                    <div class="cosmic-energy" id="cosmicEnergy" aria-hidden="true">
                        <svg viewBox="0 0 1600 900" aria-hidden="true">
                            <defs>
                                <linearGradient id="beamGrad" x1="535" y1="406" x2="1272" y2="372"
                                    gradientUnits="userSpaceOnUse">
                                    <stop offset="0" stop-color="#ffd27a" />
                                    <stop offset=".45" stop-color="#ff9d3c" />
