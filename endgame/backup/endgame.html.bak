<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>INFINITY: The Final Snap — Debug the Universe</title>
    <style>
        /* ============================================================
   INFINITY: THE FINAL SNAP — single-file cinematic debugging game
   The intentional fault: .cosmic-energy { display: none }
   ============================================================ */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        html,
        body {
            height: 100%
        }

        body {
            background: #020304;
            overflow: hidden;
            user-select: none;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        code {
            font-family: Consolas, 'Courier New', monospace
        }

        /* ---------- Stage: fixed 1600x900 design space, cover-scaled ---------- */
        #stage {
            position: absolute;
            left: 50%;
            top: 50%;
            width: 1600px;
            height: 900px;
            transform: translate(-50%, -50%) scale(var(--s, 1));
            transform-origin: center;
        }

        #camera {
            position: absolute;
            inset: 0;
            animation: camDrift 38s ease-in-out infinite alternate;
        }

        @keyframes camDrift {
            0% {
                transform: translate(0, 0) scale(1)
            }

            50% {
                transform: translate(6px, -5px) scale(1.012)
            }

            100% {
                transform: translate(-7px, 4px) scale(1.022)
            }
        }

        /* Camera moves are BOUNDED: |tx| <= (s-1)*800 and |ty| <= (s-1)*450,
   so the scene can never pull away from the viewport edges. */
        #pusher {
            position: absolute;
            inset: 0;
            transition: transform 4.5s cubic-bezier(.3, 0, .25, 1);
        }

        #pusher.pan {
            transition-duration: 2.6s
        }

        #pusher.creep {
            transition-duration: 6s
        }

        #pusher.in {
            transform: scale(1.1)
        }

        #pusher.toEnemy {
            transform: translate(-210px, 24px) scale(1.27)
        }

        #pusher.toEnemy.creep {
            transform: translate(-232px, 18px) scale(1.33)
        }

        #pusher.toHero {
            transform: translate(185px, -6px) scale(1.24)
        }

        #pusher.toHero.creep {
            transform: translate(205px, -10px) scale(1.28)
        }

        #shaker {
            position: absolute;
            inset: 0;
        }

        #shaker.go {
            animation: shk .7s cubic-bezier(.36, .07, .19, .97) both;
        }

        @keyframes shk {
            10% {
                transform: translate(-8px, 5px) rotate(-.35deg)
            }

            30% {
                transform: translate(7px, -4px) rotate(.3deg)
            }

            50% {
                transform: translate(-5px, 3px)
            }

            70% {
                transform: translate(3px, -2px)
            }

            90% {
                transform: translate(-2px, 1px)
            }

            100% {
                transform: none
            }
        }

        /* ---------- Shared layer base (characters positioned individually) ---------- */
        .layer,
        #sky,
        #horizonGlow,
        #warGlow,
        #clouds,
        #smokeBack,
        #smokeFront,
        #ground,
        #layer-far,
        #layer-mid,
        #fires,
        #layer-fore,
        #embers,
        #ash,
        #dissolve,
        #ray {
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .layer svg,
        #ground svg,
        #layer-far svg,
        #layer-mid svg,
        #layer-fore svg,
        #enemy svg,
        #hero svg {
            display: block;
            width: 100%;
            height: 100%
        }

        #enemy svg,
        #hero svg {
            overflow: visible
        }

        /* ---------- Pointer parallax (energy must track the hand exactly) ---------- */
        #layer-far,
        #smokeBack,
        #clouds,
        #ray,
        #warGlow {
            transform: translate3d(calc(var(--px, 0)*-6px), calc(var(--py, 0)*-2.5px), 0);
            transition: transform 1.4s cubic-bezier(.22, .61, .36, 1);
        }

        #ground,
        #layer-mid,
        #fires,
        #enemy,
        #hero,
        .cosmic-energy {
            transform: translate3d(calc(var(--px, 0)*-10px), calc(var(--py, 0)*-4px), 0);
            transition: transform 1.4s cubic-bezier(.22, .61, .36, 1);
        }

        #layer-fore,
        #smokeFront,
        #embers,
        #ash {
            transform: translate3d(calc(var(--px, 0)*-18px), calc(var(--py, 0)*-7px), 0);
            transition: transform 1.4s cubic-bezier(.22, .61, .36, 1);
        }

        /* ---------- Sky, clouds, horizon haze ---------- */
        #sky {
            z-index: 0;
            background: linear-gradient(180deg, #020308 0%, #080c14 30%, #131722 52%, #221a12 72%, #33200f 88%, #46290f 100%);
        }

        #clouds {
            z-index: 2
        }

        #clouds svg {
            animation: cloudsDrift 80s ease-in-out infinite alternate
        }

        @keyframes cloudsDrift {
            from {
                transform: translateX(-14px)
            }

            to {
                transform: translateX(14px)
            }
        }

        #horizonGlow {
            z-index: 1;
            left: 6%;
            right: 18%;
            bottom: 10%;
            height: 38%;
            top: auto;
            background: radial-gradient(ellipse at 40% 78%, rgba(255, 150, 55, .65), rgba(210, 100, 35, .24) 45%, transparent 72%);
            filter: blur(6px);
            mix-blend-mode: screen;
            opacity: .62;
            animation: hgFlick 7s ease-in-out infinite alternate;
            transition: opacity 2.5s ease;
        }

        @keyframes hgFlick {
            from {
                opacity: .52
            }

            to {
                opacity: .75
            }
        }

        .energized #horizonGlow {
            animation: none;
            opacity: .95
        }

        .calm #horizonGlow {
            animation: none;
            opacity: .3
        }

        #warGlow {
            z-index: 2;
            left: auto;
            top: auto;
            right: 2%;
            bottom: 16%;
            width: 40%;
            height: 40%;
            background: radial-gradient(ellipse at 55% 62%, rgba(235, 80, 45, .45), rgba(160, 35, 25, .16) 50%, transparent 72%);
            filter: blur(8px);
            mix-blend-mode: screen;
            opacity: .55;
            transition: opacity 2.5s ease;
        }

        .energized #warGlow {
            opacity: .85
        }

        .calm #warGlow {
            opacity: .18
        }

        /* ---------- Smoke & plumes (restrained) ---------- */
        #smokeBack {
            z-index: 3
        }

        #smokeFront {
            z-index: 9
        }

        #ray {
            z-index: 9;
            mix-blend-mode: screen;
            background: linear-gradient(115deg, transparent 40%, rgba(255, 190, 120, .05) 49%, rgba(255, 190, 120, .03) 53%, transparent 62%);
        }

        .smoke {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(ellipse, rgba(150, 158, 172, .09), rgba(90, 100, 115, .04) 55%, transparent 72%);
            filter: blur(14px);
        }

        .smoke.s1 {
            left: -6%;
            top: 44%;
            width: 56%;
            height: 34%;
            animation: smokeA 34s ease-in-out infinite alternate
        }

        .smoke.s2 {
            left: 44%;
            top: 36%;
            width: 48%;
            height: 30%;
            animation: smokeA 44s ease-in-out -14s infinite alternate-reverse
        }

        .smoke.s3 {
            left: 14%;
            top: 58%;
            width: 74%;
            height: 24%;
            animation: smokeB 52s ease-in-out -22s infinite alternate
        }

        @keyframes smokeA {
            from {
                transform: translateX(-3%)
            }

            to {
                transform: translateX(6%)
            }
        }

        @keyframes smokeB {
            from {
                transform: translate(4%, 0)
            }

            to {
                transform: translate(-5%, -2%)
            }
        }

        .plume {
            position: absolute;
            bottom: 26%;
            width: 110px;
            height: 340px;
            border-radius: 50% 50% 42% 42%;
            background: linear-gradient(to top, rgba(70, 52, 36, .22), rgba(40, 34, 34, .1) 55%, transparent 85%);
            filter: blur(16px);
            transform-origin: 50% 100%;
            animation: plumeSway 26s ease-in-out infinite alternate;
        }

        .plume.p1 {
            left: 20%
        }

        .plume.p2 {
            left: 46%;
            height: 410px;
            animation-delay: -9s
        }

        .plume.p3 {
            left: 71%;
            animation-delay: -17s
        }

        @keyframes plumeSway {
            from {
                transform: translateY(4%) skewX(0deg);
                opacity: .6
            }

            to {
                transform: translateY(-7%) skewX(3deg);
                opacity: .85
            }
        }

        /* ---------- Ground & wreckage ---------- */
        #ground {
            z-index: 4
        }

        #layer-mid {
            z-index: 5
        }

        #fires {
            z-index: 6
        }

        .fire {
            position: absolute;
            width: 170px;
            height: 100px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255, 170, 70, .75), rgba(255, 110, 30, .28) 55%, transparent 76%);
            filter: blur(10px);
            mix-blend-mode: screen;
            animation: fireFlick 2.8s ease-in-out infinite alternate;
            transition: opacity 2.5s ease;
        }

        .fire.f1 {
            left: 13%;
            top: 71%
        }

        .fire.f2 {
            left: 57%;
            top: 72%;
            animation-delay: -1.4s
        }

        .fire.f3 {
            left: 79%;
            top: 64%;
            animation-delay: -.7s
        }

        .fhalo {
            position: absolute;
            width: 300px;
            height: 170px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255, 150, 60, .3), transparent 70%);
            filter: blur(22px);
            mix-blend-mode: screen;
            animation: fireFlick 5.2s ease-in-out infinite alternate;
            transition: opacity 2.5s ease;
        }

        .fhalo.h1 {
            left: 10%;
            top: 66%
        }

        .fhalo.h2 {
            left: 54%;
            top: 67%;
            animation-delay: -2s
        }

        .fhalo.h3 {
            left: 76%;
            top: 58%;
            animation-delay: -3.4s
        }

        .frefl {
            position: absolute;
            width: 70px;
            height: 130px;
            mix-blend-mode: screen;
            filter: blur(6px);
            background: linear-gradient(to bottom, rgba(255, 140, 60, .3), transparent);
            animation: fireFlick 3.4s ease-in-out infinite alternate;
        }

        .frefl.r1 {
            left: 15%;
            top: 73%
        }

        .frefl.r2 {
            left: 59%;
            top: 74%;
            animation-delay: -1.6s
        }

        @keyframes fireFlick {
            0% {
                opacity: .5;
                transform: scale(1)
            }

            50% {
                opacity: .85;
                transform: scale(1.06)
            }

            100% {
                opacity: .55;
                transform: scale(.97)
            }
        }

        .calm .fire {
            opacity: .22;
            animation-duration: 7s
        }

        .calm .fhalo,
        .calm .frefl {
            opacity: .18;
            animation-duration: 9s
        }

        .wdot {
            animation: wd 3.6s ease-in-out infinite
        }

        @keyframes wd {

            0%,
            100% {
                opacity: .7
            }

            50% {
                opacity: .2
            }
        }

        /* ---------- The Titan (massive opposing figure, empty gauntlet) ---------- */
        #enemy {
            position: absolute;
            z-index: 7;
            left: 990px;
            top: 40px;
            width: 560px;
            height: 620px;
            overflow: visible;
            pointer-events: none
        }

        #g-enemy {
            transform-box: view-box;
        }

        #g-titan {
            transform-box: view-box;
            animation: tSway 7s ease-in-out infinite alternate
        }

        @keyframes tSway {
            from {
                transform: translateY(0)
            }

            to {
                transform: translateY(4px)
            }
        }

        #enemy.dissolve #g-enemy {
            animation: eDissolve 2.4s ease-in forwards;
        }

        @keyframes eDissolve {
            0% {
                opacity: 1;
                filter: blur(0);
                transform: translateY(0)
            }

            55% {
                opacity: .6;
                filter: blur(2px);
                transform: translateY(-12px)
            }

            100% {
                opacity: 0;
                filter: blur(5px);
                transform: translateY(-34px)
            }
        }

        .erim {
            fill: none;
            stroke: #d9a83f;
            stroke-width: 1.6;
            opacity: .55;
            stroke-linecap: round
        }

        .tcrack {
            fill: #ff8a3c;
            animation: wd 3.2s ease-in-out infinite
        }

        .eye {
            fill: #ffb44a;
            animation: blink 5s infinite
        }

        @keyframes blink {

            0%,
            90% {
                opacity: .9
            }

            94% {
                opacity: .15
            }

            100% {
                opacity: .9
            }
        }

        #g-earm {
            transform-box: view-box;
            transform-origin: 172px 272px;
            transform: rotate(6deg);
            transition: transform 1.5s cubic-bezier(.4, 0, .3, 1)
        }

        #enemy.raised #g-earm {
            transform: rotate(0deg)
        }

        #enemy.snapE #g-earm {
            transform: rotate(3.5deg);
            transition-duration: .12s
        }

        #g-ehead {
            transform-box: view-box;
            transform-origin: 276px 205px;
            transition: transform 1.2s ease
        }

        #enemy.confused #g-ehead {
            transform: rotate(-7deg)
        }

        /* ---------- Armored hero ---------- */
        #hero {
            position: absolute;
            z-index: 8;
            left: 150px;
            top: 330px;
            width: 500px;
            height: 470px;
            overflow: visible;
            pointer-events: none;
            transition: transform 1.4s cubic-bezier(.22, .61, .36, 1), filter 2s ease;
        }

        #hero.focus {
            filter: brightness(1.15)
        }

        #g-hero {
            transform-box: view-box;
            animation: breathe 5.5s ease-in-out infinite alternate
        }

        @keyframes breathe {
            from {
                transform: translateY(0)
            }

            to {
                transform: translateY(3px)
            }
        }

        /* The requested lean: tilted back on his heels from the reveal onward */
        #g-lean {
            transform-box: view-box;
            transform-origin: 250px 452px;
            transition: transform 1.6s cubic-bezier(.34, 0, .24, 1)
        }

        #hero.lean #g-lean {
            transform: rotate(-7deg)
        }

        #hero.lean.deep #g-lean {
            transform: rotate(-9.5deg);
            transition-duration: .5s
        }

        #g-arm {
            transform-box: view-box;
            transform-origin: 320px 200px;
            transition: transform 1.4s cubic-bezier(.4, 0, .3, 1)
        }

        #hero.charging #g-arm {
            transform: rotate(-6deg)
        }

        #hero.snapped #g-arm {
            transform: rotate(2.5deg) translateY(3px);
            transition-duration: .15s
        }

        .rim {
            fill: none;
            stroke: #d98a3f;
            stroke-width: 2;
            stroke-linecap: round;
            opacity: .4
        }

        .stone {
            transform-box: fill-box;
            transform-origin: center;
            animation: stonePulse 2.4s ease-in-out var(--d, 0s) infinite alternate;
            filter: drop-shadow(0 0 5px var(--c));
        }

        .stone .halo3 {
            fill: var(--c);
            opacity: .14
        }

        .stone .halo2 {
            fill: var(--c);
            opacity: .32
        }

        .stone .core2 {
            fill: var(--c)
        }

        .stone.big .core2 {
            fill: #fff2c4
        }

        @keyframes stonePulse {
            from {
                transform: scale(.92);
                filter: drop-shadow(0 0 4px var(--c))
            }

            to {
                transform: scale(1.12);
                filter: drop-shadow(0 0 10px var(--c))
            }
        }

        #hero.focus .stone {
            animation-duration: 1.2s
        }

        #hero.reveal .stone {
            animation-duration: .8s
        }

        #hero.reveal .stone .halo2 {
            opacity: .6
        }

        #hero.charging .stone {
            animation-duration: .5s
        }

        #hero.charging .stone .halo2 {
            opacity: .68
        }

        .arc {
            fill: none;
            stroke: #bfe9ff;
            stroke-width: 2.2;
            stroke-linecap: round;
            opacity: 0;
            filter: drop-shadow(0 0 3px #9fe8ff)
        }

        #hero.reveal .arc {
            animation: arcFlick .5s steps(3) infinite alternate
        }

        #hero.reveal .arc.a2 {
            animation-delay: .13s
        }

        #hero.reveal .arc.a3 {
            animation-delay: .27s
        }

        #hero.reveal .arc.a4 {
            animation-delay: .41s
        }

        @keyframes arcFlick {
            from {
                opacity: .1
            }

            to {
                opacity: .85
            }
        }

        #shock {
            opacity: 0;
            transform-box: view-box;
            transform-origin: 424px 92px
        }

        #shock.go {
            animation: shock 1.1s cubic-bezier(.2, .7, .3, 1) forwards
        }

        @keyframes shock {
            0% {
                opacity: .9;
                transform: scale(.2);
                stroke-width: 5
            }

            100% {
                opacity: 0;
                transform: scale(9);
                stroke-width: 1
            }
        }

        /* ---------- Foreground & particles ---------- */
        #layer-fore {
            z-index: 10
        }

        #layer-fore svg {
            filter: blur(2px)
        }

        #embers {
            z-index: 9
        }

        #ash {
            z-index: 9
        }

        #dissolve {
            z-index: 12
        }

        .ember {
            position: absolute;
            left: var(--x);
            top: var(--y);
            width: var(--sz);
            height: var(--sz);
            border-radius: 50%;
            background: #ffb066;
            box-shadow: 0 0 6px 1px rgba(255, 140, 58, .8);
            opacity: 0;
            animation: emberUp var(--t) linear infinite;
            animation-delay: var(--dl);
        }

        @keyframes emberUp {
            0% {
                transform: translate(0, 0);
                opacity: 0
            }

            8% {
                opacity: .9
            }

            60% {
                opacity: .65
            }

            100% {
                transform: translate(var(--dx), -160px);
                opacity: 0
            }
        }

        .ash {
            position: absolute;
            left: var(--x);
            top: -4%;
            width: var(--sz);
            height: var(--sz);
            border-radius: 50%;
            background: #98a0ac;
            opacity: 0;
            animation: ashFall var(--t) linear infinite;
            animation-delay: var(--dl);
        }

        @keyframes ashFall {
            0% {
                transform: translate(0, 0);
                opacity: 0
            }

            10% {
                opacity: .5
            }

            90% {
                opacity: .35
            }

            100% {
                transform: translate(var(--dx), 560px);
                opacity: 0
            }
        }

        .dp {
            position: absolute;
            width: var(--sz, 3px);
            height: var(--sz, 3px);
            border-radius: 50%;
            background: #ffcb86;
            box-shadow: 0 0 8px 2px rgba(255, 150, 60, .75);
            opacity: 0;
            animation: dFly var(--t, 1.6s) ease-out forwards;
        }

        @keyframes dFly {
            0% {
                opacity: 0;
                transform: translate(0, 0)
            }

            12% {
                opacity: .95
            }

            100% {
                opacity: 0;
                transform: translate(var(--dx, 0), var(--dy, -120px))
            }
        }

        /* ============================================================
   THE COSMIC ENERGY PATHWAY — the intentionally broken element.
   Its only display declaration lives in this single rule.
   ============================================================ */
        .cosmic-energy {
            display: none;
            /* <- the fault. Fix it in real DevTools */
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 11;
            mix-blend-mode: screen;
            overflow: visible;
        }

        .cosmic-energy svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            overflow: visible
        }

        #sparks {
            position: absolute;
            inset: 0
        }

        .beam {
            fill: none;
            stroke-dasharray: 100;
            stroke-dashoffset: 100;
            opacity: 0
        }

        .beam.halo {
            stroke: #ff8c2e;
            stroke-width: 32;
            filter: url(#eblur)
        }

        .beam.core {
            stroke: url(#beamGrad);
            stroke-width: 6;
            stroke-linecap: round
        }

        .beam.hot {
            stroke: #fff3d6;
            stroke-width: 2;
            stroke-dasharray: 6 94;
            stroke-dashoffset: 0
        }

        .cosmic-energy.active .beam.halo {
            animation: draw 2.4s cubic-bezier(.65, 0, .25, 1) forwards,
                haloPulse 3.2s ease-in-out 2.4s infinite alternate;
        }

        .cosmic-energy.active .beam.core {
            animation: draw 2.4s cubic-bezier(.65, 0, .25, 1) forwards;
        }

        .cosmic-energy.active .beam.hot {
            animation: appear .4s linear 2.4s forwards,
                flow 1.15s linear 2.4s infinite;
        }

        @keyframes draw {
            0% {
                stroke-dashoffset: 100;
                opacity: 0
            }

            8% {
                opacity: 1
            }

            100% {
                stroke-dashoffset: 0;
                opacity: 1
            }
        }

        @keyframes haloPulse {
            from {
                opacity: .85;
                stroke-width: 28
            }

            to {
                opacity: .5;
                stroke-width: 40
            }
        }

        @keyframes appear {
            to {
                opacity: .85
            }
        }

        @keyframes flow {
            to {
                stroke-dashoffset: -100
            }
        }

        .spark {
            position: absolute;
            left: 0;
            top: 0;
            width: 9px;
            height: 3px;
            border-radius: 2px;
            background: linear-gradient(90deg, rgba(255, 210, 140, 0), #ffd9a0);
            opacity: 0;
            offset-path: path("M535,406 C750,190 1010,640 1272,372");
            will-change: offset-distance;
        }

        .cosmic-energy.active .spark {
            animation: travel var(--t, 1.5s) linear infinite;
            animation-delay: var(--dl, 0s);
        }

        @keyframes travel {
            0% {
                offset-distance: 0%;
                opacity: 0
            }

            8% {
                opacity: .95
            }

            85% {
                opacity: .85
            }

            100% {
                offset-distance: 100%;
                opacity: 0
            }
        }

        .mote {
            position: absolute;
            left: 0;
            top: 0;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--c, #ffd24a);
            box-shadow: 0 0 12px 3px var(--c, #ffd24a);
            opacity: 0;
            offset-path: path("M535,406 C750,190 1010,640 1272,372");
        }

        .cosmic-energy.active .mote {
            animation: travel var(--t, 2.4s) cubic-bezier(.45, .05, .55, .95) infinite;
            animation-delay: var(--dl, 0s);
        }

        .bloom {
            position: absolute;
            left: 1272px;
            top: 372px;
            width: 14px;
            height: 14px;
            margin: -7px 0 0 -7px;
            border-radius: 50%;
            opacity: 0;
            background: radial-gradient(circle, #fff6dd 0%, rgba(255, 190, 90, .7) 40%, rgba(255, 140, 50, 0) 72%);
        }

        .cosmic-energy.active .bloom {
            animation: bloomIn 2.2s ease-out 1.7s forwards;
        }

        @keyframes bloomIn {
            0% {
                opacity: 0;
                transform: scale(.4)
            }

            100% {
                opacity: .95;
                transform: scale(7)
            }
        }

        .calm .cosmic-energy {
            opacity: .55;
            transition: opacity 2.5s ease, transform 1.4s cubic-bezier(.22, .61, .36, 1)
        }

        /* ---------- Snap flash (separate from the energy pathway) ---------- */
        #flash {
            position: absolute;
            inset: 0;
            z-index: 13;
            opacity: 0;
            mix-blend-mode: screen;
            background: radial-gradient(circle at 33.5% 45%, #fff8ea 0%, #ffd9a0 18%, rgba(255, 150, 60, .55) 38%, rgba(255, 120, 40, 0) 68%);
        }

        #flash.go {
            animation: flash 1s ease-out forwards
        }

        @keyframes flash {
            0% {
                opacity: 0
            }

            6% {
                opacity: 1
            }

            22% {
                opacity: .85
            }

            100% {
                opacity: 0
            }
        }

        /* ---------- Cinematic frame ---------- */
        #vignette {
            position: fixed;
            inset: 0;
            z-index: 40;
            pointer-events: none;
            background:
                linear-gradient(180deg, rgba(0, 0, 0, .68), transparent 11%, transparent 89%, rgba(0, 0, 0, .68)),
                radial-gradient(ellipse at 50% 44%, transparent 44%, rgba(0, 0, 0, .4) 78%, rgba(0, 0, 0, .68) 100%);
        }

        #grain {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 39;
            pointer-events: none;
            opacity: .055;
            mix-blend-mode: overlay
        }

        /* ============================================================ UI ============================================================ */
        #ui {
            position: fixed;
            inset: 0;
            z-index: 60;
            pointer-events: none
        }

        #hud {
            position: absolute;
            left: 38px;
            bottom: 34px;
            max-width: 60vw;
            font: 600 12px/1.6 'Segoe UI', system-ui, sans-serif;
            letter-spacing: .32em;
            text-transform: uppercase;
            color: #c8b28c;
            opacity: 0;
            transition: opacity .9s ease;
            text-shadow: 0 1px 8px rgba(0, 0, 0, .75);
        }

        #hud.on {
            opacity: .92
        }

        #caption {
            position: absolute;
            left: 50%;
            bottom: 88px;
            transform: translateX(-50%);
            max-width: 76vw;
            text-align: center;
            font-style: italic;
            font-family: Georgia, 'Times New Roman', serif;
            font-weight: 400;
            font-size: clamp(20px, 2.4vw, 30px);
            letter-spacing: .04em;
            color: #ece5d2;
            opacity: 0;
            transition: opacity .7s ease, transform .7s ease;
            text-shadow: 0 2px 16px rgba(0, 0, 0, .95), 0 0 2px rgba(0, 0, 0, .9);
        }

        #caption.on {
            opacity: 1
        }

        #toast {
            position: absolute;
            left: 50%;
            top: 19%;
            transform: translate(-50%, 10px);
            font-family: Georgia, 'Times New Roman', serif;
            font-size: clamp(22px, 3vw, 34px);
            letter-spacing: .3em;
            text-transform: uppercase;
            text-align: center;
            color: #f2c069;
            opacity: 0;
            transition: opacity .7s ease, transform .7s ease;
            text-shadow: 0 2px 18px rgba(0, 0, 0, .8);
        }

        #toast.on {
            opacity: 1;
            transform: translate(-50%, 0)
        }

        /* ---------- Title ---------- */
        #title {
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
            text-align: center;
            pointer-events: auto;
            background: linear-gradient(180deg, rgba(3, 5, 9, .9), rgba(4, 6, 10, .62) 46%, rgba(8, 5, 3, .88));
            transition: opacity 1.8s ease, visibility 0s linear 1.8s;
        }

        #title.gone {
            opacity: 0;
            visibility: hidden;
            pointer-events: none
        }

        .kicker {
            font: 600 11px 'Segoe UI', system-ui, sans-serif;
            letter-spacing: .5em;
            color: #8b8577;
            margin-bottom: 26px
        }

        #title h1 {
            font-family: Georgia, 'Times New Roman', serif;
            font-weight: 400;
            font-size: clamp(54px, 9.5vw, 132px);
            line-height: .95;
            letter-spacing: .16em;
            margin-left: .16em;
            color: #e9e3d3;
        }

        #title .t2 {
            display: block;
            font-family: 'Segoe UI', system-ui, sans-serif;
            font-weight: 600;
            font-size: clamp(14px, 2vw, 23px);
            letter-spacing: .62em;
            margin-left: .62em;
            margin-top: 16px;
            color: #c99a54;
        }

        .rule {
            width: min(420px, 60vw);
            height: 1px;
            margin: 28px auto;
            background: linear-gradient(90deg, transparent, rgba(210, 160, 90, .8), transparent);
        }

        .sub {
            font: 500 clamp(13px, 1.6vw, 17px) 'Segoe UI', system-ui, sans-serif;
            letter-spacing: .56em;
            margin-left: .56em;
            color: #b7ad99
        }

        button.cta {
            pointer-events: auto;
            margin-top: 44px;
            background: transparent;
            cursor: pointer;
            border: 1px solid rgba(220, 170, 100, .55);
            color: #e6c98f;
            text-transform: uppercase;
            font: 600 13px 'Segoe UI', system-ui, sans-serif;
            letter-spacing: .42em;
            padding: 15px 44px 15px 52px;
            transition: background .3s, border-color .3s, color .3s;
        }

        button.cta:hover {
            background: rgba(230, 180, 110, .1);
            border-color: #e6c98f;
            color: #ffe9bd
        }

        button.cta:focus-visible {
            outline: 2px solid #e6c98f;
            outline-offset: 4px
        }

        .note {
            margin-top: 30px;
            font: 400 12px/1.7 'Segoe UI', system-ui, sans-serif;
            letter-spacing: .08em;
            color: #6f6a5e
        }

        .note code {
            color: #a8977a;
            font-size: 11.5px
        }

        /* ---------- Debug diagnostic panel ---------- */
        #debug {
            position: absolute;
            top: 26px;
            left: 26px;
            width: min(362px, calc(100vw - 40px));
            max-height: calc(100% - 60px);
            overflow: auto;
            outline: none;
            background: rgba(7, 9, 13, .86);
            border: 1px solid rgba(226, 168, 88, .28);
            padding: 20px 22px 16px;
            color: #cfc8b8;
            font: 400 13px/1.65 'Segoe UI', system-ui, sans-serif;
            opacity: 0;
            visibility: hidden;
            transform: translateX(-14px);
            transition: opacity .8s ease, transform .8s ease, visibility 0s linear .8s;
        }

        #debug.shown {
            opacity: 1;
            visibility: visible;
            transform: none;
            pointer-events: auto;
            transition: opacity .8s ease, transform .8s ease;
        }

        #debug h2 {
            font: 700 13px 'Segoe UI', system-ui, sans-serif;
            letter-spacing: .22em;
            color: #f0b45c;
            margin-bottom: 10px
        }

        #debug .lead {
            margin-bottom: 10px
        }

        #debug .mission {
            border-left: 2px solid rgba(226, 168, 88, .4);
            padding-left: 10px;
            margin: 10px 0 12px;
            color: #ddd5c2
        }

        #debug ol {
            margin: 0 0 12px 18px
        }

        #debug li {
            margin-bottom: 6px
        }

        #debug code {
            font-size: 12px;
            color: #f0c98c;
            background: rgba(240, 190, 110, .08);
            padding: 1px 5px;
            border-radius: 3px;
            border: 1px solid rgba(240, 190, 110, .15)
        }

        #debug .small {
            margin: 0;
            color: #6f6a5e;
            font-size: 11.5px
        }

        #debug .pulse {
            margin-top: 12px;
            font-size: 11px;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: #8f8672;
            display: flex;
            align-items: center;
            gap: 8px
        }

        #debug .pulse i {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #f0b45c;
            animation: ping 1.6s ease-in-out infinite
        }

        @keyframes ping {

            0%,
            100% {
                opacity: .25
            }

            50% {
                opacity: 1
            }
        }

        /* BYPASS button styling (temporary testing aid) */
        #debug .bypassRow {
            margin-top: 14px;
            padding-top: 12px;
            border-top: 1px solid rgba(226, 168, 88, .18);
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap
        }

        button.cta.mini {
            margin-top: 0;
            padding: 8px 16px 8px 20px;
            font-size: 11px;
            letter-spacing: .28em;
            border-color: rgba(226, 168, 88, .4);
            color: #d9c193
        }

        button.cta.mini:hover {
            border-color: #e6c98f;
            color: #ffe9bd;
            background: rgba(230, 180, 110, .08)
        }

        button.cta.mini:focus-visible {
            outline: 2px solid #e6c98f;
            outline-offset: 3px
        }

        #debug .bypassHint {
            font-size: 11px;
            color: #6f6a5e
        }

        /* ---------- End screen ---------- */
        #end {
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
            text-align: center;
            pointer-events: none;
            opacity: 0;
            visibility: hidden;
            background: radial-gradient(ellipse at 50% 58%, rgba(10, 8, 6, .76), rgba(2, 3, 5, .92));
            transition: opacity 2s ease, visibility 0s linear 2s;
        }

        #end.shown {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transition: opacity 2s ease
        }

        #end h2 {
            font-family: Georgia, 'Times New Roman', serif;
            font-weight: 400;
            color: #e9e3d3;
            font-size: clamp(36px, 5.5vw, 68px);
            letter-spacing: .2em;
            margin-left: .2em;
        }

        #end .kicker {
            margin-bottom: 18px
        }

        #end p.sub {
            margin-top: 20px
        }

        #end button.cta {
            margin-top: 38px
        }

        #end .note {
            margin-top: 22px
        }

        /* ---------- Reduced motion: calmer equivalents ---------- */
        @media (prefers-reduced-motion: reduce) {
            #camera {
                animation: none
            }

            #shaker.go {
                animation: none
            }

            #pusher {
                transition-duration: .01s
            }

            #pusher.creep {
                transition-duration: .01s
            }

            #pusher.toEnemy,
            #pusher.toHero,
            #pusher.in {
                transform: none
            }

            #g-earm,
            #g-ehead,
            #g-lean {
                transition: none
            }

            .smoke,
            .plume {
                animation: none
            }

            #clouds svg {
                animation: none
            }

            .fhalo {
                animation: none
            }

            .ember,
            .ash {
                animation: none;
                opacity: .22
            }

            .stone {
                animation: none
            }

            #g-hero,
            #g-titan {
                animation: none
            }

            #hero.reveal .arc {
                animation: none;
                opacity: .2
            }

            #flash.go {
                animation-duration: .45s
            }

            .cosmic-energy.active .beam.halo {
                animation: draw 1.2s ease-out forwards
            }

            .cosmic-energy.active .beam.core {
                animation: draw 1.2s ease-out forwards
            }

            .cosmic-energy.active .beam.hot {
                animation: none;
                opacity: 0
            }

            .cosmic-energy.active .spark,
            .cosmic-energy.active .mote {
                animation: none;
                opacity: 0
            }

            .cosmic-energy.active .bloom {
                animation: bloomIn 1.2s ease-out 1.1s forwards
            }

            #enemy.dissolve #g-enemy {
                animation: eDissolve 1.4s ease-in forwards
            }

            .dp {
                animation-duration: 1.2s
            }
        }
    </style>
</head>

<body>

    <main id="stage" aria-hidden="true">
        <div id="camera">
            <div id="pusher">
                <div id="shaker">

                    <div id="sky"></div>
                    <div id="horizonGlow"></div>

                    <!-- Storm clouds, underlit by the burning horizon -->
                    <div id="clouds" class="layer">
                        <svg viewBox="0 0 1600 900" aria-hidden="true">
                            <defs>
                                <filter id="cblur" x="-40%" y="-40%" width="180%" height="180%">
                                    <feGaussianBlur stdDeviation="11" />
                                </filter>
                            </defs>
                            <g filter="url(#cblur)">
                                <g fill="#0a0d14" opacity=".9">
                                    <ellipse cx="300" cy="120" rx="300" ry="88" />
                                    <ellipse cx="900" cy="90" rx="360" ry="105" />
                                    <ellipse cx="1430" cy="140" rx="270" ry="92" />
                                    <ellipse cx="640" cy="215" rx="380" ry="70" opacity=".7" />
                                    <ellipse cx="1200" cy="235" rx="330" ry="64" opacity=".65" />
                                </g>
                                <g fill="#5a3414" opacity=".38">
                                    <ellipse cx="470" cy="330" rx="300" ry="46" />
                                    <ellipse cx="1130" cy="310" rx="260" ry="42" />
                                </g>
                            </g>
                        </svg>
                    </div>

                    <div id="warGlow"></div>

                    <!-- Far ruins, burning ridge line -->
                    <div id="layer-far" class="layer">
                        <svg viewBox="0 0 1600 900" aria-hidden="true">
                            <g fill="#1d2536">
                                <path d="M96,742 L96,540 L128,522 L128,478 L150,492 L152,560 L188,560 L190,742 Z" />
                                <path d="M296,742 L306,436 L318,404 L330,442 L338,742 Z" />
                                <path d="M660,742 L664,600 L690,586 L692,742 Z" opacity=".85" />
                                <path d="M1424,742 L1432,560 L1452,542 L1454,498 L1472,522 L1480,566 L1494,742 Z" />
                                <path d="M1520,742 L1516,640 L1560,600 L1600,620 L1600,742 Z" />
                            </g>
                            <g fill="#171e2c">
                                <path d="M500,742 L560,650 L610,660 L680,742 Z" />
                                <path d="M768,742 L770,470 L776,470 L778,600 L800,604 L802,742 Z" />
                                <path d="M860,742 L900,690 L940,700 L980,742 Z" />
                                <path d="M1060,742 L1070,620 L1090,610 L1100,742 Z" />
                                <path d="M330,620 Q420,556 520,594 L512,618 Q428,588 342,642 Z" />
                                <path d="M348,626 L360,610 M392,610 L400,594 M448,600 L456,586" stroke="#242e42"
                                    stroke-width="3" fill="none" />
                            </g>
                            <path
                                d="M96,540 L128,522 L128,478 M306,436 L318,404 L330,442 M770,470 L776,470 M1432,560 L1452,542 L1454,498"
                                stroke="#8a5a26" stroke-width="2" opacity=".35" fill="none" />
                            <g fill="#ff9a45">
                                <rect class="wdot" x="140" y="600" width="4" height="3" />
                                <rect class="wdot" x="316" y="470" width="4" height="3" style="animation-delay:-1.2s" />
                                <rect class="wdot" x="240" y="610" width="4" height="3" style="animation-delay:-2.4s" />
                                <rect class="wdot" x="432" y="586" width="4" height="3" style="animation-delay:-.5s" />
                                <rect class="wdot" x="760" y="600" width="4" height="3" style="animation-delay:-3s" />
                                <rect class="wdot" x="980" y="572" width="4" height="3" style="animation-delay:-1.8s" />
                                <rect class="wdot" x="1452" y="580" width="4" height="3"
                                    style="animation-delay:-2.1s" />
                                <rect class="wdot" x="1560" y="660" width="4" height="3" style="animation-delay:-.6s" />
                            </g>
                        </svg>
                    </div>

                    <div id="smokeBack" class="layer">
                        <div class="smoke s1"></div>
                        <div class="smoke s2"></div>
                        <div class="plume p1"></div>
                        <div class="plume p2"></div>
                        <div class="plume p3"></div>
                    </div>

                    <!-- Ground plane with the mound the Titan stands on -->
                    <div id="ground" class="layer">
                        <svg viewBox="0 0 1600 900" aria-hidden="true">
                            <defs>
                                <linearGradient id="gGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" stop-color="#1b1a24" />
                                    <stop offset=".35" stop-color="#0d0f16" />
                                    <stop offset="1" stop-color="#06070b" />
                                </linearGradient>
                            </defs>
                            <path fill="url(#gGrad)"
                                d="M0,738 L90,726 L170,734 L260,720 L340,730 L430,722 L520,732 L610,724 L700,730 L790,720 L880,728 L960,722 L1040,726 L1100,700 L1180,652 L1245,640 L1320,660 L1400,706 L1480,722 L1600,730 L1600,900 L0,900 Z" />
                            <path d="M1100,700 L1180,652 L1245,640 L1320,660" stroke="#7a4e22" stroke-width="2"
                                opacity=".4" fill="none" />
                            <path
                                d="M60,800 L210,786 M320,830 L470,818 M700,806 L840,812 M980,840 L1120,828 M1250,760 L1330,772"
                                stroke="#191e28" stroke-width="2" opacity=".7" fill="none" />
                            <g>
                                <path d="M540,742 l18,-16 24,4 8,14 z" fill="#12151d" />
                                <path d="M540,726 l18,-16" stroke="#7a4e22" stroke-width="2" fill="none" opacity=".5" />
                                <path d="M420,760 l14,-12 20,2 6,12 z" fill="#10131a" />
                                <path d="M880,756 l20,-14 26,6 6,12 z" fill="#12151d" />
                                <path d="M880,742 l20,-14" stroke="#7a4e22" stroke-width="2" fill="none"
                                    opacity=".45" />
                                <path d="M150,772 l16,-12 22,4 4,12 z" fill="#10131a" />
                                <path d="M1040,780 l18,-14 24,4 6,14 z" fill="#12151d" />
                            </g>
                        </svg>
                    </div>

                    <!-- Mid wreckage -->
                    <div id="layer-mid" class="layer">
                        <svg viewBox="0 0 1600 900" aria-hidden="true">
                            <path d="M600,742 Q660,636 790,626 Q880,622 936,690 L946,742 Z" fill="#10141c" />
                            <path d="M622,716 Q676,646 790,634" stroke="#8a5a26" stroke-width="2.5" fill="none"
                                opacity=".5" />
                            <path d="M660,700 L668,660 M710,676 L714,644 M760,652 L762,636" stroke="#141a26"
                                stroke-width="4" fill="none" />
                            <path d="M1120,742 L1172,600 L1182,604 L1140,742 Z" fill="#0f131b" />
                            <path d="M180,742 L236,688 L300,678 L352,742 Z" fill="#0f131b" />
                            <path d="M250,700 L292,690" stroke="#71481f" stroke-width="2" opacity=".4" fill="none" />
                            <path d="M380,742 L410,700 L444,712 L470,742 Z" fill="#0d1119" />
                        </svg>
                    </div>

                    <div id="fires">
                        <div class="fhalo h1"></div>
                        <div class="fhalo h2"></div>
                        <div class="fhalo h3"></div>
                        <div class="fire f1"></div>
                        <div class="fire f2"></div>
                        <div class="fire f3"></div>
                        <div class="frefl r1"></div>
                        <div class="frefl r2"></div>
                    </div>

                    <!-- THE TITAN: massive armored figure, ornate gauntlet, empty stone sockets -->
                    <div id="enemy">
                        <svg viewBox="0 0 560 620" aria-hidden="true">
                            <defs>
                                <linearGradient id="tSkin" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" stop-color="#66527f" />
                                    <stop offset="1" stop-color="#332845" />
                                </linearGradient>
                                <linearGradient id="tSkinHi" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" stop-color="#87709f" />
                                    <stop offset="1" stop-color="#4a3b60" />
                                </linearGradient>
                                <linearGradient id="tArm" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" stop-color="#54421f" />
                                    <stop offset="1" stop-color="#211a0d" />
                                </linearGradient>
                                <linearGradient id="tArmHi" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" stop-color="#776335" />
                                    <stop offset="1" stop-color="#2e2414" />
                                </linearGradient>
                            </defs>
                            <g id="g-enemy">
                                <g id="g-titan">
                                    <ellipse cx="280" cy="604" rx="172" ry="16" fill="#000" opacity=".55" />

                                    <!-- legs -->
                                    <path d="M210,470 L196,540 L186,596 L232,600 L242,540 L252,478 Z" fill="#171221" />
                                    <path d="M340,472 L360,542 L372,598 L326,602 L316,542 L306,480 Z" fill="#141020" />
                                    <path d="M196,540 L242,540 M316,542 L360,542" stroke="#241c30" stroke-width="3"
                                        opacity=".6" fill="none" />
                                    <path d="M182,592 L236,596 L240,606 L176,604 Z" fill="#0c0912" />
                                    <path d="M322,596 L378,592 L384,606 L318,606 Z" fill="#0c0912" />

                                    <!-- right arm, down at the side -->
                                    <path
                                        d="M380,268 Q412,288 420,332 L426,392 Q428,420 410,426 L390,420 Q394,362 382,322 Q372,292 354,280 Z"
                                        fill="#171221" />
                                    <path d="M398,408 Q424,404 430,430 Q428,450 402,450 Q384,446 388,422 Z"
                                        fill="#241c30" />
                                    <path d="M400,420 L424,418 M402,430 L424,428" stroke="#171221" stroke-width="2.5"
                                        fill="none" opacity=".8" />

                                    <!-- torso armor -->
                                    <path
                                        d="M186,460 L178,320 Q176,268 216,252 L344,252 Q386,268 384,322 L376,462 Q280,498 186,460 Z"
                                        fill="url(#tArm)" />
                                    <path d="M232,268 L330,268 L322,352 Q280,368 240,354 Z" fill="url(#tArmHi)"
                                        opacity=".95" />
                                    <path d="M280,270 L280,360 M240,300 L322,296 M236,330 L320,326" stroke="#1a1409"
                                        stroke-width="2.5" fill="none" opacity=".8" />
                                    <path d="M212,300 L226,318 L218,336" stroke="#0d0a06" stroke-width="2.5"
